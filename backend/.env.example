# --- App ---
APP_NAME="AI Debate Coach & Presentation Analysis Platform"
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- PostgreSQL (primary relational DB) ---
POSTGRES_USER=debate_user
POSTGRES_PASSWORD=debate_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=debate_coach_db

# --- MongoDB (secondary DB: skill tracking, session logs) ---
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=debate_coach_mongo

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Google OAuth2 (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
