# =========================================================
# Agentic AI Debate Coach & Presentation Analysis Platform
# Environment Configuration Template (.env.example)
# =========================================================

# ---------------------------------------------------------
# Application & Frontend Configuration
# ---------------------------------------------------------
# API Base URL for Frontend client requests
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------
# PostgreSQL Database Configuration
# ---------------------------------------------------------
# Local Development: postgresql://username:password@localhost:5432/debate_coach_db
# Docker Deployment:  postgresql://postgres:password@postgres:5432/debate_coach_db
DATABASE_URL=postgresql://username:password@localhost:5432/debate_coach_db

# ---------------------------------------------------------
# MongoDB & GridFS Storage Configuration
# ---------------------------------------------------------
# Stores binary presentation audio (GridFS), AI analysis reports, and conversation memory
# Local Development: mongodb://localhost:27017
# Docker Deployment:  mongodb://mongodb:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=agentic_ai_debate_coach

# ---------------------------------------------------------
# Authentication / JWT Configuration
# ---------------------------------------------------------
# Secure random string for JWT token signing
SECRET_KEY=change-me-in-production-with-a-secure-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------
# AI / LLM Configuration
# Primary provider: groq | Fallback provider: ollama
# ---------------------------------------------------------
LLM_PROVIDER=groq

# Groq API Configuration (Cloud LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Configuration (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM Inference Parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ---------------------------------------------------------
# Vector Database / FAISS Evidence Store Configuration
# ---------------------------------------------------------
# Local path for FAISS vector index files
FAISS_INDEX_PATH=data/faiss