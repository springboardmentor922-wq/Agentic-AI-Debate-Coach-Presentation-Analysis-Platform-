# --- MongoDB Atlas ---
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_DB_NAME=debate_coach_db

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# --- Multi-provider LLM support ---
# LLM_PROVIDER is tried first for every AI text-generation call. If it fails
# for any reason (quota, auth, network, timeout), LLM_FALLBACK_PROVIDER is
# tried automatically. Leave LLM_FALLBACK_PROVIDER blank to disable it.
# If both fail (or neither is configured), the app automatically falls back
# to a deterministic, rule-based analysis engine so the platform still
# produces meaningful argument analysis, fallacy detection, scoring, and
# feedback reports even with zero LLM providers configured.
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Milestone 3: audio/video upload pipeline (requires ffmpeg on the host for video)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100
ALLOWED_AUDIO_EXT=mp3,wav,m4a,webm
ALLOWED_VIDEO_EXT=mp4,mov,avi

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- App environment ---
# In "development" (default), OTP codes and password-reset tokens are echoed
# back in API responses whenever no real email/SMS provider is configured
# below, so those flows can be tested without paid provider accounts.
APP_ENV=development
OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Email OTP / password reset delivery (optional; SMTP) ---
# Leave blank to use development mode (codes/links logged + returned in the API response).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ai-debate-coach.local

# --- Mobile OTP delivery (optional; Twilio) ---
# Leave blank to use development mode (codes logged + returned in the API response).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- OAuth2 login (optional; Google) ---
# Leave blank to disable OAuth2 login (endpoints respond 501 Not Configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
